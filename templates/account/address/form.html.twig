{% extends 'base.html.twig' %}

{% block title %}Mes Adresses - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-1">

    {# Inclusion de la bannière utilisateur #}
    {% include "account/_user_header.html.twig" %}

    
    {# Barre de navigation cohérente #}
    <div class="d-flex justify-content-between align-items-center mb-4 py-3 border-bottom">
        <div>
            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                <i data-feather="home" class="feather feather-home fas fa-home me-2"></i>Accueil
            </a>
            <a href="{{ path('app_account') }}" class="btn btn-outline-secondary ms-2">
                <i data-feather="user" class="feather feather-user fas fa-user me-2"></i>Mon compte
            </a>
        </div>
        <h1 class="mb-0 fs-3 fw-bold text-primary">
            <i data-feather="map-pin" class="feather feather-map-pin fas fa-map-pin"></i>Mes Adresses
        </h1>
    </div>

    <div class="row g-4">
        {# Menu de gauche - style cohérent #}
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    {% include "account/_menu.html.twig" %}
                </div>
            </div>
        </div>
        
        {# Formulaire d'adresse - style cohérent #}
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h4 fw-bold mb-4">
                        <i data-feather="edit-2" class="feather feather-edit-2 fas fa-edit"></i>Formulaire d'adresse
                    </h3>

                    {{ form_start(addressform) }}
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_row(addressform.firstname, {
                                    'label': 'Prénom',
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(addressform.lastname, {
                                    'label': 'Nom',
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                        </div>

                        {{ form_row(addressform.address, {
                            'label': 'Adresse',
                            'attr': {'class': 'form-control mt-3'}
                        }) }}

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                {{ form_row(addressform.postal, {
                                    'label': 'Code postal',
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(addressform.city, {
                                    'label': 'Ville',
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(addressform.country, {
                                    'label': 'Pays',
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(addressform.phone, {
                                    'label': 'Téléphone',
                                    'attr': {'class': 'form-control'}
                                }) }}
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i data-feather="save" class="feather feather-save fas fa-save"></i>Enregistrer l'adresse
                            </button>
                        </div>
                    {{ form_end(addressform) }}
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}