{% extends 'base.html.twig' %}

{% block title %}Mon Compte - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-1">
    {# Barre de navigation #}

    
      {# Inclusion de la bannière utilisateur #}
    {% include "account/_user_header.html.twig" %}


    <div class="d-flex justify-content-between align-items-center mb-4 py-3 border-bottom">
        <div>
            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                <i data-feather="home" class="feather feather-home fas fa-home"></i>Accueil
            </a>
        </div>
        <h1 class="mb-0 fs-3 fw-bold text-primary">
            <i data-feather="user" class="feather feather-user fas fa-user"></i> Mon Compte
        </h1>
    </div>

    <div class="row g-4">
        {# Menu de gauche #}
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-80">
                <div class="card-body p-0">  {# Suppression du padding pour le menu #}
                    {% include "account/_menu.html.twig" %}
                </div>
            </div>
        </div>
        
        {# Contenu principal #}
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-80">
                <div class="card-body p-4 text-center d-flex flex-column justify-content-center">
                    {# Photo de profil #}
                  {% if app.user.title == 'Monsieur' %}
        <div class="user-avatar me-3">
          <img src="https://www.w3schools.com/howto/img_avatar.png" 
                             alt="Photo de profil" 
                             class="rounded-circle shadow-sm"
                             style="width: 120px; height: 120px; object-fit: cover;">
        </div>
        {% else %}
        <div class="user-avatar me-3">
          <img src="https://www.w3schools.com/howto/img_avatar2.png" 
                             alt="Photo de profil" 
                             class="rounded-circle shadow-sm"
                             style="width: 120px; height: 120px; object-fit: cover;">
        </div>
        {% endif %}
                    {# Informations utilisateur #}
                    <div class="mb-4">
                        <h3 class="fw-bold mb-2">
                            Bienvenue, {{ app.user.lastname }}
                        </h3>
                        <div class="d-flex align-items-center justify-content-center mb-2">
                            <i data-feather="mail" class="me-2 text-muted"></i>
                            <span class="text-muted">{{ app.user.email }}</span>
                        </div>
                    </div>
                    
                    <p class="mb-4 text-muted">
                        Vous êtes maintenant connecté à votre espace personnel.
                    </p>
                    
                    {# Bouton #}
                    <div class="mt-3">
                        <a href="#" class="btn btn-primary px-4">
                            <i data-feather="user" class="feather feather-user fas fa-user"></i>Voir mon profil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}