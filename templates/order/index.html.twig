{# templates/order/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Ma Commande - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-12 mx-auto">
            
            {# Breadcrumb identique à la page réglementation #}
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_cart') }}">Panier</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Commande</li>
                </ol>
            </nav>

            {# Titre de la page #}
            <div class="d-flex" style="justify-content: space-between;"><h1 class="display-5 mb-4">Ma Commande</h1> <h3>Date aujourd'hui: {{ "now"|date("m/d/Y") }} </h3></div>
<hr>
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card shadow-sm mb-5">
                        <div class="card-body">
                            {{ form_start(deliveryForm) }}
                            
                            {# Section Adresse #}
                            <div class="mb-5">
                                <h2 class="h4 mb-4 pb-3 border-bottom">
                                    <i class="fas fa-truck me-2 text-primary"></i>
                                    Informations de Livraison
                                </h2>
                                
                                <div class="mb-4">
                                    {{ form_row(deliveryForm.addresses, {
                                        'label': 'Adresse de livraison',
                                        'attr': {'class': 'form-select mb-3'}
                                    }) }}
                                    
                                    <a href="{{ path('app_account_address_form') }}" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-plus-circle me-1"></i> Ajouter une nouvelle adresse
                                    </a>
                                </div>
                            </div>

                            {# Section Transporteur #}
                            <div class="mb-5">
                                <h2 class="h4 mb-4 pb-3 border-bottom">
                                    <i class="fas fa-shipping-fast me-2 text-primary"></i>
                                    Options de Livraison
                                </h2>
                                
                                <div class="form-group">
                                    {{ form_row(deliveryForm.carrier, {
                                        'label': false,
                                        'attr': {'class': 'list-unstyled'}
                                    }) }}
                                </div>
                            </div>

                            {# Bouton de validation
                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-check-circle me-2"></i> Valider la commande
                                </button>
                            </div> #}

                            {{ form_end(deliveryForm) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Formatage des options de transporteur
        document.querySelectorAll('.form-check-input').forEach(radio => {
            const parent = radio.closest('.form-check');
            const label = parent.querySelector('.form-check-label');
            
            if (priceMatch) {
                const priceSpan = document.createElement('span');
                priceSpan.className = 'float-end text-success fw-bold';
                priceSpan.textContent = priceMatch[0];
                label.textContent = label.textContent.replace(priceMatch[0], '').trim();
                label.appendChild(priceSpan);
            }
        });
    });
</script>
{% endblock %}