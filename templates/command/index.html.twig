{% extends 'base.html.twig' %}

{% block title %}Commande #{{order.id}} - {{ parent() }}{% endblock %}

{% block body %}
<div class="container py-4">
    {% include "account/_user_header.html.twig" %}
    
    <div class="d-flex justify-content-between align-items-center mb-4 py-3 border-bottom">
        <div>
            <a href="{{ path('app_account_order') }}" class="btn btn-outline-secondary">
                <i data-feather="arrow-left" class="me-2"></i>Retour aux commandes
            </a>
            {% if order.state >0 %}
            <a target="_blank" href="{{ path('app_invoice_user', {id_order: order.id}) }}" class="btn btn-primary">
                <i class="fas fa-download"></i> Facture
            </a>
            {% endif %}
        </div>
        <h1 class="mb-0 fs-3 fw-bold text-primary">
            <i data-feather="file-text" class="me-2"></i>Commande {{order.createdAt|date('Y')}}/{{ order.id }}
            <span class="badge bg-{{ order.currency == 'MAD' ? 'success' : 'info' }} ms-2">
                {{ order.currency }} (Paiement)
            </span>
        </h1>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-0">
                    {% include "account/_menu.html.twig" %}
                </div>
            </div>
        </div>
        
        <div class="col-md-9">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h2 class="h4 fw-bold mb-2">Commande: {{order.createdAt|date('Y')}}/{{ order.id }}</h2>
                            <div class="d-flex align-items-center mb-1">
                                <strong class="me-2">Statut :</strong>
                                {{ include('admin/order_state.html.twig', { field: { 'value': order.state } }) }}
                            </div>
                            <div class="text-muted small">
                                <i data-feather="calendar" class="me-1"></i>
                                {{ order.createdAt|date('d/m/Y à H:i') }}
                            </div>
                        </div>
                        {% if order.currency == 'EUR' %}
                            <div class="alert alert-info p-2 mb-0">
                                <small>
                                    <i class="fas fa-info-circle"></i> Cette commande a été payée en Euros
                                </small>
                            </div>
                        {% endif %}
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">
                                    <h3 class="h6 fw-bold mb-3">
                                        <i data-feather="truck" class="me-2"></i>Livraison
                                    </h3>
                                    <p class="mb-1"><strong>Transporteur :</strong> {{ order.carrierName }}</p>
                                    <p class="mb-1"><strong>Coût :</strong> 
                                        {% if order.currency == 'EUR' %}
                                                {{ (order.carrierPrice/ 10)|format_currency('EUR')  }}
                                        {% else %}
                                                {{ order.carrierPrice |format_currency('MAD') }}
                                        {% endif %}
                                    </p>
                                    <p class="mb-0"><strong>Adresse :</strong> {{ order.delivery|nl2br }}</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">
                                    <h3 class="h6 fw-bold mb-3">
                                        <i data-feather="credit-card" class="me-2"></i>Paiement
                                    </h3>
                                    <p class="mb-1">
                                        <strong>Méthode :</strong> 
                                        {{ order.paymentMethod|default('Carte bancaire') }}
                                    </p>
                                    <p class="mb-0">
                                        <strong>Devise originale :</strong> 
                                        <span class="badge bg-{{ order.currency == 'MAD' ? 'success' : 'info' }}">
                                            {{ order.currency }}
                                        </span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3 class="h5 fw-bold mb-3">
                        <i data-feather="shopping-cart" class="me-2"></i>Produits commandés
                    </h3>
                    
                    <div class="table-responsive mb-4">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Produit</th>
                                    <th style="width: 100px;">Image</th>
                                    <th class="text-center">Qté</th>
                                    <th class="text-end">Prix unitaire</th>
                                    <th class="text-end">TVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for detail in order.orderDetails %}
                                    <tr>
                                        <td><strong>{{ detail.productName }}</strong></td>
                                        <td>
                                            <img src="/uploads/products/{{ detail.productIllustration }}"
                                                 alt="{{ detail.productName }}"
                                                 class="img-fluid rounded border"
                                                 style="max-width: 80px; height: auto;">
                                        </td>
                                        <td class="text-center">{{ detail.productQuantity }}</td>
                                        <td class="text-end">
                                            {% if order.currency == 'EUR' %}
                                            {{ (detail.productPrice/ 10)|format_currency('EUR') }}
                                            {% else %}
                                                {{ detail.productPrice |format_currency('MAD') }}
                                            {% endif %}



                                        </td>
                                        <td class="text-end">{{ detail.productTva }}%</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i data-feather="alert-circle" class="me-2"></i>
                                            Aucun produit dans cette commande
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <h4 class="h6 fw-bold mb-3">Récapitulatif</h4>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Total HT :</span>
                                        <strong>
                                         {% if order.currency == 'EUR' %}
                                                {{ (order.getTotalHT()/10)|format_currency('EUR') }}
                                            {% else %}
                                                {{ order.getTotalHT()|format_currency('MAD') }}
                                            {% endif %}  
                                        </strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>TVA :</span>
                                        <strong>
                                         {% if order.currency == 'EUR' %}
                                                {{ ((order.getTotalTVA())/10)|format_currency('EUR') }}
                                            {% else %}
                                                {{ (order.getTotalTVA())|format_currency('MAD') }}
                                            {% endif %}  
                                        </strong>
                                    </div>
                                    <div class="d-flex justify-content-between border-top pt-2">
                                        <span class="fw-bold">Total TTC :</span>
                                        <strong class="text-primary">
                                            {# {{ ((order.getTotalHT() + order.getTotalTVA())/ 10)|format_currency(order.currency) }} #}
                                              {% if order.currency == 'EUR' %}
                                                {{ ((order.getTotalHT() + order.getTotalTVA())/10)|format_currency('EUR') }}
                                            {% else %}
                                                {{ (order.getTotalHT() + order.getTotalTVA())|format_currency('MAD') }}
                                            {% endif %}  
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge.bg-success { background-color: #28a745 !important; }
    .badge.bg-info { background-color: #17a2b8 !important; }
</style>
{% endblock %}
