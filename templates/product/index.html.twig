{# templates/product/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
    {% for prod in product %}
        {{ prod.name }} - {{ parent() }}
    {% endfor %}
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-12 mx-auto">
            
            {# Breadcrumb #}
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    {% for prod in product %}
                        <li class="breadcrumb-item"><a href="{{ path('show_category', {slug: prod.category.slug}) }}">{{ prod.category.name }}</a></li>
                        <li class="breadcrumb-item active" aria-current="page">{{ prod.name }}</li>
                    {% endfor %}
                </ol>
            </nav>

            {# Titre et référence #}
            {% for prod in product %}
                <h1 class="display-5 mb-4">{{ prod.name }}</h1>
				<hr>

                <div class="text-muted mb-4">
                    <i class="fas fa-tag me-2"></i>
                    Référence : {{ prod.slug }}
                </div>
            {% endfor %}

            {# Contenu principal #}
            {% for prod in product %}
            <div class="row">
                {# Colonne image - Sans cadre #}
                <div class="col-md-3 mb-4 mt-3">
                    <img src="/uploads/products/{{ prod.illustration }}" alt="{{ prod.name }}" 
                         class="img-fluid rounded" style="object-fit: contain; max-height: 400px; background: transparent;">
                </div>

                {# Colonne détails #}
                <div class="col-md-7">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            {# Prix et wishlist #}
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <span class="badge bg-primary fs-4 p-2">
                                    {{ prod.pricewithtax|format_price }}
                                </span>
                                
                                {% if app.user and prod in app.user.wishlists %}
                                    <a href="{{ path('app_account_wishlist_remove', { id: prod.id }) }}" 
                                       class="btn btn-sm btn-warning">
                                        <i class="fas fa-heart text-danger me-2"></i>Retirer de la liste
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_account_wishlist_add', { id: prod.id }) }}" 
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="far fa-heart text-danger me-2"></i>Liste de souhaits
                                    </a>
                                {% endif %}
                            </div>

                           <div style="max-height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 8px;">
    {{ prod.description|raw }}
</div>
                            {# Bouton ajouter au panier #}
                            <div class="d-grid gap-2">
                                <a href="{{ path('app_cart_add', { id: prod.id }) }}" 
                                   class="btn btn-success btn-lg">
                                    <i class="fas fa-shopping-cart me-2"></i>Ajouter au panier
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .product-content {
        font-size: 1.1rem;
        line-height: 1.8;
    }
    .product-content h2 {
        margin-top: 2rem;
        margin-bottom: 1rem;
        color: #2c3e50;
    }
    .product-content ul {
        padding-left: 2rem;
    }
    .product-content li {
        margin-bottom: 0.5rem;
    }
    .card {
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-3px);
    }
    /* Style pour l'image sans fond */
    .img-fluid.rounded {
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
    }
</style>
{% endblock %}