<html lang="fr">
	<head>
		<meta charset="utf-8">
		<title>Facture {{order.createdAt|date('Y')}}/{{ order.id }}</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
		<style>
			body {
				font-family: Arial, sans-serif;
				font-size: 12px;
			}
			.invoice-header {
				border-bottom: 1px solid #eee;
				margin-bottom: 20px;
				padding-bottom: 20px;
			}
			.invoice-title {
				color: #333;
				font-size: 24px;
				font-weight: bold;
				text-align: center;
			}
			.client-info {
				margin-bottom: 30px;
			}
			.table-items {
				width: 100%;
				border-collapse: collapse;
				margin: 20px 0;
			}
			.table-items th {
				background-color: #f8f9fa;
				padding: 8px;
				text-align: left;
			}
			.table-items td {
				padding: 8px;
				border-bottom: 1px solid #eee;
			}
			.text-right {
				text-align: right;
			}
			.total-section {
				background-color: #f8f9fa;
				padding: 15px;
				border-radius: 5px;
				margin-top: 20px;
			}
			.footer {
				margin-top: 40px;
				font-size: 0.8em;
				color: #777;
				border-top: 1px solid #eee;
				padding-top: 15px;
			}
		</style>
	</head>
	<body>
		<div
			class="container">
			<!-- En-tête -->
			<div class="row invoice-header">
				<div class="col-md-6">
					<div class="">
						<div class="img">
							<img style="width:100px; height:100px;" src="data:image/jpeg;base64,">
	                   </div>
						<body>
							<div
								class="container">
								<!-- En-tête -->
								<div class="row invoice-header">
									<div class="col-md-6">
										<div class="">
											<h1>Kech Lotus Cooperative</h1>
											<hr>
											<h1 class="invoice-title">FACTURE</h1>
											<hr>
										</div>
										<p>
											<strong>N°
												{{order.createdAt|date('Y')}}/{{ order.id }}</strong>
										</p>
										<p>Date:
											{{ order.createdAt|date('d/m/Y') }}</p>
									</div>
									<div
										class="row" style="display: flex; flex-wrap: wrap; width: 100%; margin-bottom: 30px; height:150px;">
										<!-- Colonne Entreprise -->
										<div style="width: 48%; padding-right: 2%; float: left; box-sizing: border-box; height:150px;">
											<div style="background: #f8f9fa; padding: 15px; border-radius: 5px; height: 100%;">
												<h5 style="margin-top: 0; border-bottom: 1px solid #ddd; padding-bottom: 10px;">Émetteur</h5>
												<p style="margin: 5px 0;">
													<strong>VOTRE BOUTIQUE</strong>
												</p>
												<p style="margin: 5px 0;">Adresse de l'entreprise</p>
												<p style="margin: 5px 0;">ICE: XXXX XXX XXX XXXXX</p>
												<p style="margin: 5px 0;">Patente: FRXXXXXXXXX</p>
											</div>
										</div>

										<!-- Colonne Client -->
										<div style="width: 48%; padding-left: 2%; float: left; box-sizing: border-box; height:150px;">
											<div style="background: #f8f9fa; padding: 15px; border-radius: 5px; height: 100%;">
												<h5 style="margin-top: 0; border-bottom: 1px solid #ddd; padding-bottom: 10px;">Client</h5>
												<p style="margin: 5px 0;">
													<strong>{{ order.user.firstname }}
														{{ order.user.lastname }}</strong>
												</p>
												<p style="margin: 5px 0; white-space: pre-line;">{{ order.delivery }}</p>
												<p style="margin: 5px 0;">Email:
													{{ order.user.email }}</p>
												<p style="margin: 5px 0;">Téléphone:
													{{ order.user.phone ?? 'Non renseigné' }}</p>
											</div>
										</div>
										<!-- Clearfix -->
										<div style="clear: both;"></div>
									</div>
									<br/>

									<!-- Détails de la commande -->
									<table class="table table-items">
										<thead>
											<tr>
												<th>Produit</th>
												<th class="text-right">Quantité</th>
												<th class="text-right">Prix unitaire HT</th>
												<th class="text-right">TVA (20%)</th>
												<th class="text-right">Total TTC</th>
											</tr>
										</thead>
										<tbody>
											{% if order.orderDetails|length > 0 %}
												{% for detail in order.orderDetails %}
													<tr>
														<td>{{ detail.productName }}</td>
														<td class="text-right">{{ detail.productQuantity }}</td>
														<td class="text-right">{{ detail.productPrice|number_format(2, ',', ' ') }}
															Dhs</td>
														<td class="text-right">{{ (detail.productPrice * 0.2)|number_format(2, ',', ' ') }}
															Dhs</td>
														<td class="text-right">{{ (detail.productQuantity * detail.productPrice * 1.2)|number_format(2, ',', ' ') }}
															Dhs</td>
													</tr>
												{% endfor %}
											{% else %}
												<tr>
													<td colspan="5" class="text-center">Aucun détail de commande trouvé</td>
												</tr>
											{% endif %}

											<!-- Frais de livraison -->
											<tr>
												<td colspan="4">
													<strong>Frais de livraison ({{ order.carrierName }})</strong>
												</td>
												<td class="text-right">{{ order.carrierPrice|number_format(2, ',', ' ') }}
													Dhs</td>
											</tr>
										</tbody>
									</table>

									<!-- Totaux -->
									<div class="row justify-content-end">
										<div class="col-md-4 total-section">
											<table class="table" style="margin-left: auto; margin-right: 0;">
												<tr>
													<td class="text-end">Sous-total HT:</td>
													<td class="text-end">{{ order.getTotalHT|number_format(2, ',', ' ') }}
														Dhs</td>
												</tr>
												<tr>
													<td class="text-end">TVA (20%):</td>
													<td class="text-end">{{ order.getTotalTVA|number_format(2, ',', ' ') }}
														Dhs</td>
												</tr>
												<tr class="table-active">
													<th class="text-end">Total TTC:</th>
													<th class="text-end">{{ order.getTotalTTC|number_format(2, ',', ' ') }}
														Dhs</th>
												</tr>
											</table>
										</div>
									</div>

									<!-- Mentions -->
									<div class="footer">
										<p>
											<strong>Mode de paiement:</strong>
											Paiement par carte bancaire</p>
										<p>
											<strong>Identifiant transaction:</strong>
											{{ order.stripeSessionId }}</p>
										<p class="mt-3">En cas de retard de paiement, pénalités de 3 fois le taux d'intérêt légal.</p>
									</div>
								</div>
							</div>
						</body>
					</html>
