{% extends 'base.html.twig' %}

{% block title %}Accès impossible{% endblock %}

{% block body %}
<style>
    .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 70vh;
        text-align: center;
    }

    .error-title {
        font-size: 3rem;
        font-weight: bold;
        color: #dc3545;
    }

    .error-message {
        font-size: 1.2rem;
        margin-top: 1rem;
        color: #555;
    }

    .error-link {
        margin-top: 2rem;
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

    .error-link:hover {
        background-color: #0056b3;
    }
</style>

<div class="error-container">
    <h1 class="error-title">Accès impossible</h1>
    <p class="error-message">
        Merci de vous connecter pour accéder à cette page protégée.
    </p>
    <a href="{{ path('app_login') }}" class="error-link">Se connecter</a>
</div>
{% endblock %}
