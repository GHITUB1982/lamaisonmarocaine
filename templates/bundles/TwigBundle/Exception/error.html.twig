{% extends 'base.html.twig' %}

{% block title %}Page non trouvée{% endblock %}

{% block body %}
<style>
    .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 70vh;
        text-align: center;
    }

    .error-title {
        font-size: 2.5rem;
        font-weight: bold;
        color: #dc3545;
    }

    .error-message {
        font-size: 1.1rem;
        margin-top: 1rem;
        color: #555;
    }

    .error-link {
        margin-top: 1.5rem;
        display: inline-block;
        padding: 0.6rem 1.2rem;
        background-color: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        transition: background-color 0.3s ease;
    }

    .error-link:hover {
        background-color: #0056b3;
    }
</style>

<div class="error-container">
    <h1 class="error-title">Impossible d'exécuter cette demande</h1>
    <p class="error-message">
        La page demandée est introuvable. Vérifiez l’URL ou 
        <a href="{{ path('app_home') }}" class="error-link">retournez à la page d’accueil</a>.
    </p>
</div>
{% endblock %}
