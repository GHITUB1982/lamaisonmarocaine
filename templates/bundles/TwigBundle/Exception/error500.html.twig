{% extends 'base.html.twig' %}

{% block title %}Page non trouvée - 404{% endblock %}

{% block body %}
<style>
    .error-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: 80vh;
        color: #444;
    }

    .error-code {
        font-size: 6rem;
        font-weight: bold;
        color: #6B8E23;
    }

    .error-message {
        font-size: 1.5rem;
        margin: 1rem 0;
    }

    .error-actions a {
        display: inline-block;
        margin-top: 1.5rem;
        padding: 0.75rem 1.5rem;
        background-color: #6B8E23;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        transition: background-color 0.3s;
    }

    .error-actions a:hover {
        background-color: #55771C;
    }
</style>

<div class="error-container">
    <div class="error-code">404</div>
    <div class="error-message">
        Page non trouvée<br>
        La page demandée est introuvable.<br>
        Vérifiez l’URL ou retournez à l’accueil.
    </div>
    <div class="error-actions">
        <a href="{{ path('app_home') }}">Retour à l'accueil</a>
    </div>
</div>
{% endblock %}
