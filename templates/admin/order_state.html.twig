{# /**
 * Représente l'état de la commande.
 * 0 = En attente de paiement
 * 1 = Paiement accepté
 * 2 = En cours de préparation
 * 3 = En cours de Livraison
 * 4 = Livraison effectuée
 * 5 = Commande annulée
 * 6 = Commande remboursée
 * * @var int|null
 * 
 */ #}

{% if field.value == 0 %}
    <span class="badge bg-info text-dark">En attente de paiement</span>
{% elseif field.value == 1 %}
    <span class="badge bg-warning text-dark">Paiement accepté</span>
{% elseif field.value == 2 %}
    <span class="badge bg-primary">Préparation en cours</span>
{% elseif field.value == 3 %}
    <span class="badge bg-success">Livraison en cours</span>
{% elseif field.value == 4 %}
    <span class="badge bg-success">Livrée</span>
{% elseif field.value == 5 %}
    <span class="badge bg-danger">Annulée</span>
{% else %}
    <span class="badge bg-secondary">Statut inconnu</span>
{% endif %}