{# templates/category/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
    {{ category.name }} - {{ parent() }}
{% endblock %}

{% block body %}
{# Variables pour la devise - à définir au début du template #}
{% set rate = app.session.get('currency') == 'EUR' ? 0.1 : 1 %}
{% set symbol = app.session.get('currency') == 'EUR' ? '€' : 'Dhs' %}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-12 mx-auto">
            
            {# Breadcrumb #}
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ category.name }}</li>
                </ol>
            </nav>

            {# Titre de la page #}
            <div class="d-flex align-items-center justify-content-between p-2">
                <h1 class="display-5 p-1">{{ category.name }}</h1>

                {# Référence catégorie #}
                <div class="text-muted p-1">
                    <i class="fas fa-tag me-2"></i>
                    Collection : {{ category.slug }}
                </div>
            </div>
            <hr>

            {# Liste des produits #}
            {% if category.products is empty %}
                <div class="card shadow-sm mb-5">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-box-open text-muted mb-3" style="font-size: 2rem;"></i>
                        <h3 class="text-muted">Aucun produit disponible</h3>
                        <p class="text-muted">Cette catégorie ne contient aucun produit pour le moment.</p>
                    </div>
                </div>
            {% else %}
                <div class="row g-4">
                    {% for product in category.products %}
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="card shadow-sm h-100 product-card">
                                {# Image du produit #}
                                <div class="card-img-container">
                                    <img src="/uploads/products/{{ product.illustration }}" 
                                         alt="{{ product.name }}" 
                                         class="card-img-top"
                                         style="object-fit: cover; height: 200px; background: transparent;"
                                         loading="lazy">
                                </div>

                                <div class="card-body">
                                    {# En-tête avec prix et wishlist #}
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <span class="badge bg-primary">
                                            {{ (product.pricewithtax * rate)|number_format(2, '.', ' ') ~ ' ' ~ symbol }}
                                        </span>
                                        
                                        {% if app.user %}
                                            {% if product in app.user.wishlists %}
                                                <a href="{{ path('app_account_wishlist_remove', { id: product.id }) }}" 
                                                   class="btn btn-sm btn-warning" 
                                                   title="Retirer des favoris">
                                                    <i class="fas fa-heart text-danger"></i>
                                                </a>
                                            {% else %}
                                                <a href="{{ path('app_account_wishlist_add', { id: product.id }) }}" 
                                                   class="btn btn-sm btn-outline-secondary"
                                                   title="Ajouter aux favoris">
                                                    <i class="far fa-heart text-danger"></i>
                                                </a>
                                            {% endif %}
                                        {% else %}
                                            <a href="{{ path('app_login') }}" 
                                               class="btn btn-sm btn-outline-secondary"
                                               title="Connectez-vous pour ajouter aux favoris">
                                                <i class="far fa-heart text-muted"></i>
                                            </a>
                                        {% endif %}
                                    </div>

                                    {# Titre et description #}
                                    <h5 class="card-title">{{ product.name }}</h5>
                                    <p class="card-text text-muted small">
                                        {% if product.description|length > 80 %}
                                            {{ product.description|striptags|slice(0, 80) }}...
                                        {% else %}
                                            {{ product.description|striptags }}
                                        {% endif %}
                                    </p>
                                </div>

                                {# Boutons d'action #}
                                <div class="card-footer bg-transparent border-top-0">
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('app_product', {'slug': product.slug}) }}" 
                                           class="btn btn-sm btn-outline-primary flex-grow-1">
                                            <i class="fas fa-eye me-1"></i>Voir
                                        </a>
                                        <a href="{{ path('app_cart_add', { id: product.id }) }}" 
                                           class="btn btn-sm btn-success"
                                           title="Ajouter au panier">
                                            <i class="fas fa-shopping-cart"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.product-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-radius: 10px;
    overflow: hidden;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
}

.card-img-container {
    overflow: hidden;
}

.card-img-top {
    transition: transform 0.3s ease;
}

.product-card:hover .card-img-top {
    transform: scale(1.05);
}

.badge {
    font-size: 0.9rem;
    padding: 0.5rem;
}

.btn-sm {
    font-size: 0.8rem;
}
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion des boutons wishlist
    const wishlistButtons = document.querySelectorAll('a[href*="wishlist"]');
    
    wishlistButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            // Animation du bouton
            const icon = this.querySelector('i');
            if (icon) {
                icon.classList.add('fa-bounce');
                setTimeout(() => {
                    icon.classList.remove('fa-bounce');
                }, 1000);
            }
        });
    });

    // Animation des boutons d'ajout au panier
    const cartButtons = document.querySelectorAll('a[href*="cart_add"]');
    
    cartButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            const icon = this.querySelector('i');
            if (icon) {
                icon.classList.add('fa-spin');
                setTimeout(() => {
                    icon.classList.remove('fa-spin');
                }, 500);
            }
        });
    });

    // Amélioration du lazy loading pour les images
    if ('IntersectionObserver' in window) {
        const imageObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    img.classList.add('fade-in');
                    observer.unobserve(img);
                }
            });
        });

        document.querySelectorAll('.card-img-top').forEach(img => {
            imageObserver.observe(img);
        });
    }
});
</script>
{% endblock %}