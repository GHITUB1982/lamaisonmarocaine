{# templates/category/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
    {{ category.name }} - {{ parent() }}
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-12 mx-auto">
            
            {# Breadcrumb identique à la page réglementation #}
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{ category.name }}</li>
                </ol>
            </nav>

            {# Titre de la page #}
            <h1 class="display-5 mb-4">{{ category.name }}</h1>
            <hr>

            {# Référence catégorie #}
            <div class="text-muted mb-4">
                <i class="fas fa-tag me-2"></i>
                Collection : {{ category.slug }}
            </div>

            {# Liste des produits #}
            {% if category.products is empty %}
                <div class="card shadow-sm mb-5">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-box-open text-muted mb-3" style="font-size: 2rem;"></i>
                        <h3 class="text-muted">Aucun produit disponible</h3>
                        <p class="text-muted">Cette catégorie ne contient aucun produit pour le moment.</p>
                    </div>
                </div>
            {% else %}
                <div class="row g-4">
                    {% for product in category.products %}
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="card shadow-sm h-100">
                                {# Image du produit - Sans cadre #}
                                <img src="/uploads/products/{{ product.illustration }}" 
                                     alt="{{ product.name }}" 
                                     class="img-fluid rounded-top"
                                     style="object-fit: cover; height: 200px; background: transparent;">

                                <div class="card-body">
                                    {# En-tête avec prix et wishlist #}
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <span class="badge bg-primary">
                                            {{ product.pricewithtax|format_price }}
                                        </span>
                                        
                                        {% if app.user and product in app.user.wishlists %}
                                            <a href="{{ path('app_account_wishlist_remove', { id: product.id }) }}" 
                                               class="btn btn-sm btn-warning">
                                                <i class="fas fa-heart text-danger"></i>
                                            </a>
                                        {% else %}
                                            <a href="{{ path('app_account_wishlist_add', { id: product.id }) }}" 
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="far fa-heart text-danger"></i>
                                            </a>
                                        {% endif %}
                                    </div>

                                    {# Titre et description #}
                                    <h5 class="card-title">{{ product.name }}</h5>
                                    <p class="card-text text-muted small">
                                        {{ product.description|striptags|slice(0, 80) ~ '...' }}
                                    </p>
                                </div>

                                {# Boutons d'action #}
                                <div class="card-footer bg-transparent border-top-0">
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('app_product', {'slug': product.slug}) }}" 
                                           class="btn btn-sm btn-outline-primary flex-grow-1">
                                            <i class="fas fa-eye me-1"></i>Voir
                                        </a>
                                        <a href="{{ path('app_cart_add', { id: product.id }) }}" 
                                           class="btn btn-sm btn-success">
                                            <i class="fas fa-shopping-cart"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .card {
        transition: transform 0.2s;
        border: none;
    }
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }
    .card-img-top {
        border-radius: 0.5rem 0.5rem 0 0 !important;
    }
    .price-badge {
        font-size: 1rem;
        padding: 0.35rem 0.65rem;
    }
</style>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Animation au survol des cartes
        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-5px)';
                this.style.boxShadow = '0 10px 20px rgba(0, 0, 0, 0.1)';
            });
            card.addEventListener('mouseleave', function() {
                this.style.transform = '';
                this.style.boxShadow = '';
            });
        });
    });
</script>
{% endblock %}