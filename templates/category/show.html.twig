{% extends 'base.html.twig' %}

{% block title %}
	{{category.name}}
	- Produits
{% endblock %}

{% block body %}

	<div class="container ">
		<h1>Catégorie:
			<strong>{{ category.name }}</strong>
		</h1>
		<p class="text-muted">Slug:
			<strong>{{ category.slug }}</strong>
		</p>
		{% if category.products is empty %}
			<h4 class="text-muted mt-5 ">Aucune catégorie trouvée.</h4>
		{% else %}
			<div class="row g-4">
				{% for product in category.products %}
					<div class="col-12 col-sm-6 col-md-4 col-lg-3">
						<div class="card h-100 shadow-sm">
							<img src="/uploads/products/{{ product.illustration }}" alt="{{ product.name }}" class="card-img-top" style="object-fit:cover; height:200px;">
							<div class="card-body d-flex flex-column">
								<h5 class="card-title">{{ product.name }}</h5>
								<p class="card-text text-truncate">{{ product.description|striptags|slice(0, 80) ~ '...' }}</p>
								<a href="{{ path('app_product', {'slug': product.slug}) }}" class="btn btn-primary mt-auto"><i data-feather="eye"></i> Voir le produit</a>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>

		{% endif %}
	</div>
{% endblock %}
