{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Thème moderne appliqué uniquement aux styles */
        .category-banner {
            background: linear-gradient(to right, #f8f9fa, #ffffff);
            border-left: 4px solid var(--primary);
        }
        .table {
            --bs-table-bg: transparent;
            border-color: #eee;
        }
        .table th {
            background-color: #f8f9fa;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }
        .img-thumbnail {
            border-radius: 8px;
            transition: transform 0.3s;
        }
        .img-thumbnail:hover {
            transform: scale(1.05);
        }
        .btn-group .btn {
            padding: 0.25rem 0.5rem;
        }
        .card {
            border: none;
            box-shadow: 0 2px 20px rgba(0,0,0,0.08);
            border-radius: 12px;
        }
        .badge {
            font-weight: 500;
            padding: 0.35em 0.65em;
        }
        .sticky-top {
            top: 20px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container my-1">
    {# Bannière conservée identique mais stylisée #}
    <div class="category-banner mb-4 p-3 rounded bg-light" style="height: 80px;">
        <div class="h-100 d-flex align-items-center px-3 border-start border-4 border-primary">
            <h2 class="h4 mb-0 text-dark">
                <i data-feather="shopping-cart" class="me-2 text-primary"></i>
                Mon Panier 
            </h2>
        </div>
    </div>

    {# Barre de navigation identique mais stylisée #}
    <div class="d-flex justify-content-between align-items-center mb-4 py-3 border-bottom">
        <div>
            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                <i data-feather="home" class="me-2"></i>Accueil
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary ms-2">
                <i data-feather="arrow-left" class="me-2"></i>Retour
            </a>
        </div>
    </div>

    {# Contenu principal inchangé mais avec styles modernes #}
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            {% if cart is empty %}
                <div class="alert alert-warning text-center mt-5 py-4 rounded-3">
                    <i data-feather="shopping-cart" class="feather-24 mb-3"></i>
                    <h5 class="fw-semibold">Votre panier est vide</h5>
                    <p class="mb-0">Commencez votre shopping dès maintenant !</p>
                </div>
            {% else %}
                <h4 class="mb-4 d-flex align-items-center">
                    <span class="me-2">Votre sélection</span>
                    <span class="badge bg-primary rounded-pill">{{ cart|length }}</span>
                </h4>
                
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Illustration</th>
                                <th>Produit</th>
                                <th>Prix</th>
                                <th class="text-center">Quantité</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set cart_total = 0 %}
                            {% for item in cart %}
                                <tr class="hover-shadow">
                                    <td>
                                        <img src="{{ item.product.illustration ? asset('uploads/products/' ~ item.product.illustration) : asset('images/default-product.png') }}"
                                             alt="{{ item.product.name }}" 
                                             class="img-thumbnail" style="width: 90px; height: 90px;">
                                    </td>
                                    <td>
                                        <strong>{{ item.product.name }}</strong>
                                        <div class="text-muted small mt-1">
                                            <i data-feather="tag" class="feather-12 me-1"></i> {{ item.product.category.name }}
                                        </div>
                                    </td>
                                    <td>{{ item.product.pricewithtax|format_price }}</td>
                                    <td class="text-center">
                                        <div class="btn-group shadow-sm" role="group">
                                            <a href="{{ path('app_cart_decrease', { id: item.product.id }) }}" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i data-feather="minus"></i>
                                            </a>
                                            <span class="px-3 py-1 bg-light">{{ item.quantity }}</span>
                                            <a href="{{ path('app_cart_add', { id: item.product.id }) }}" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i data-feather="plus"></i>
                                            </a>
                                        </div>
                                    </td>
                                    <td class="fw-bold">
                                        {% set total = item.product.pricewithtax * item.quantity %}
                                        {{ total|format_price }}
                                    </td>
                                                                <td>
                                    <a href="{{ path('app_cart_remove', { id: item.product.id }) }}" 
                                    class="btn btn-sm btn-outline-danger"
                                    title="Supprimer ce produit">
                                        <i data-feather="trash-2"></i>
                                    </a>
                                </td>
                                </tr>
                                {% set cart_total = cart_total + total %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>

        {# Colonne récap inchangée mais stylisée #}
        {% if cart is not empty %}
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm sticky-top">
                <div class="card-body">
                    <h5 class="card-title mb-3 d-flex align-items-center">
                        <i data-feather="file-text" class="me-2 text-primary"></i>
                        <span>Récapitulatif</span>
                    </h5>
                    
                    <ul class="list-group list-group-flush mb-3">
                        {% for item in cart %}
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <span class="text-truncate" style="max-width: 70%;">{{ item.product.name }}</span>
                                <span class="badge bg-primary rounded-pill">x{{ item.quantity }}</span>
                            </li>
                        {% endfor %}
                    </ul>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Total HT :</span>
                        <span>{{ (cart_total / 1.2)|format_price }}</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-success">
                        <span>TVA (20%) :</span>
                        <span>{{ (cart_total - (cart_total / 1.2))|format_price }}</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3 py-2 border-top border-bottom">
                        <span class="fw-bold">Total TTC :</span>
                        <span class="fw-bold text-primary">{{ cart_total|format_price }}</span>
                    </div>

                    <a href="{{ path('app_order') }}" class="btn btn-primary w-100 mb-2 py-2">
                        <i data-feather="credit-card" class="me-2"></i> Commander
                    </a>
                    <a href="{{ path('app_cart_remove') }}" class="btn btn-outline-danger w-100 py-2">
                        <i data-feather="trash" class="me-2"></i> Vider le panier
                    </a>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            feather.replace();
        });
    </script>
{% endblock %}
{% endblock %}