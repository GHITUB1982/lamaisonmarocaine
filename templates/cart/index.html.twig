{# templates/cart/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-12 mx-auto">
            
            {# Breadcrumb identique à la page réglementation #}
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Mon panier</li>
                </ol>
            </nav>

            {# Titre de la page #}
            <h1 class="display-5 mb-4">Mon panier</h1>
<hr>
            {# Nombre d'articles #}
            <div class="text-muted mb-4">
                <i class="fas fa-shopping-cart me-2"></i>
                {{ cart|length }} article(s) dans votre panier
            </div>

            {% if cart is empty %}
                {# Panier vide - version carte comme réglementation #}
                <div class="card shadow-sm mb-5">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-shopping-cart text-muted mb-3" style="font-size: 2rem;"></i>
                        <h3 class="text-muted">Votre panier est vide</h3>
                        <p class="text-muted">Commencez votre shopping dès maintenant !</p>
                        <a href="{{ path('app_home') }}" class="btn btn-primary mt-3">
                            <i class="fas fa-store me-2"></i>Voir nos produits
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="row">
                    {# Colonne principale - Liste des produits #}
                    <div class="col-lg-8">
                        <div class="card shadow-sm mb-5">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Produit</th>
                                                <th>Prix</th>
                                                <th class="text-center">Quantité</th>
                                                <th>Total</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% set cart_total = 0 %}
                                            {% for item in cart %}
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <img src="{{ item.product.illustration ? asset('uploads/products/' ~ item.product.illustration) : asset('images/default-product.png') }}" 
                                                                 alt="{{ item.product.name }}" 
                                                                 class="img-fluid rounded me-3" 
                                                                 style="width: 80px; height: 80px; object-fit: cover; background: transparent;">
                                                            <div>
                                                                <strong>{{ item.product.name }}</strong>
                                                                <div class="text-muted small">
                                                                    {{ item.product.category.name }}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>{{ item.product.pricewithtax|format_price }}</td>
                                                    <td class="text-center">
                                                        <div class="btn-group" role="group">
                                                            <a href="{{ path('app_cart_decrease', { id: item.product.id }) }}" 
                                                               class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-minus"></i>
                                                            </a>
                                                            <span class="px-3 py-1">{{ item.quantity }}</span>
                                                            <a href="{{ path('app_cart_add', { id: item.product.id }) }}" 
                                                               class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-plus"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                    <td class="fw-bold">
                                                        {% set total = item.product.pricewithtax * item.quantity %}
                                                        {{ total|format_price }}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('app_cart_remove', { id: item.product.id }) }}" 
                                                           class="btn btn-sm btn-outline-danger">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                                {% set cart_total = cart_total + total %}
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Colonne récapitulative #}
                    <div class="col-lg-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h3 class="h4 mb-4 pb-3 border-bottom">
                                    <i class="fas fa-file-alt me-2 text-primary"></i>
                                    Récapitulatif
                                </h3>

                                <ul class="list-group list-group-flush mb-3">
                                    {% for item in cart %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                            <span class="text-truncate" style="max-width: 70%;">{{ item.product.name }}</span>
                                            <span class="badge bg-primary rounded-pill">x{{ item.quantity }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total HT :</span>
                                    <span>{{ (cart_total / 1.2)|format_price }}</span>
                                </div>

                                <div class="d-flex justify-content-between mb-3 text-success">
                                    <span>TVA (20%) :</span>
                                    <span>{{ (cart_total - (cart_total / 1.2))|format_price }}</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3 py-2 border-top border-bottom">
                                    <span class="fw-bold">Total TTC :</span>
                                    <span class="fw-bold text-primary">{{ cart_total|format_price }}</span>
                                </div>

                                <div class="d-grid gap-2">
                                    <a href="{{ path('app_order') }}" class="btn btn-primary">
                                        <i class="fas fa-credit-card me-2"></i>
                                        Commander
                                    </a>
                                    <a href="{{ path('app_cart_clear') }}" class="btn btn-outline-danger">
                                        <i class="fas fa-trash me-2"></i>
                                        Vider le panier
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Section Wishlist #}
                <div class="card shadow-sm mt-5">
                    <div class="card-body">
                        <h3 class="h4 mb-4 pb-3 border-bottom">
                            <i class="fas fa-heart text-danger me-2"></i>
                            Mes Produits Favoris
                        </h3>

                        {% if wishlistItems is empty %}
                            <div class="text-center py-5">
                                <i class="fas fa-heart text-muted mb-3" style="font-size: 2rem;"></i>
                                <h4 class="text-muted">Votre wishlist est vide</h4>
                                <p class="text-muted">Ajoutez des produits à votre wishlist en cliquant sur l'icône cœur</p>
                                <a href="{{ path('app_home') }}" class="btn btn-primary mt-3">
                                    <i class="fas fa-store me-2"></i>Voir nos produits
                                </a>
                            </div>
                        {% else %}
                            <div class="row g-4">
                                {% for product in wishlistItems %}
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                        <div class="card h-100 border-0">
                                            {# Image sans cadre #}
                                            <img src="/uploads/products/{{ product.illustration }}" 
                                                 alt="{{ product.name }}"
                                                 class="img-fluid rounded-top"
                                                 style="height: 180px; object-fit: cover; background: transparent;">

                                            <div class="card-body">
                                                <div class="d-flex justify-content-between">
                                                    <h5 class="card-title">{{ product.name }}</h5>
                                                    <a href="{{ path('app_account_wishlist_remove', {id: product.id}) }}" 
                                                       class="btn btn-sm btn-danger">
                                                        <i class="fas fa-times"></i>
                                                    </a>
                                                </div>
                                                <div class="d-flex justify-content-between align-items-center mt-3">
                                                    <span class="fw-bold text-primary">
                                                        {{ product.pricewithtax|format_price }}
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="card-footer bg-transparent border-top-0">
                                                <div class="d-grid gap-2">
                                                    <a href="{{ path('app_product', {slug: product.slug}) }}" 
                                                       class="btn btn-sm btn-outline-primary">
                                                        <i class="fas fa-eye me-1"></i>Voir
                                                    </a>
                                                    <a href="{{ path('app_cart_add', {id: product.id}) }}" 
                                                       class="btn btn-sm btn-success">
                                                        <i class="fas fa-shopping-cart me-1"></i>Panier
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .table {
        background: #fff;
        border-radius: 0.5rem;
    }
    .table th {
        background-color: #f8f9fa;
    }
    .img-fluid.rounded-top {
        border-radius: 0.5rem 0.5rem 0 0 !important;
    }
    .card {
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-3px);
    }
</style>
{% endblock %}