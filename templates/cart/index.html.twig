{# templates/cart/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-12 mx-auto">
           
            {# Breadcrumb identique à la page réglementation #}
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Mon panier</li>
                </ol>
            </nav>

            {# Titre de la page #}
            <h1 class="display-5 mb-4">Mon panier</h1>
            <hr>

            {# Nombre d'articles #}
            <div class="text-muted mb-4">
                <i class="fas fa-shopping-cart me-2"></i>
                {{ cart|length }} article(s) dans votre panier
            </div>

            {% if cart is empty %}
                {# Panier vide - version carte comme réglementation #}
                <div class="card shadow-sm mb-5">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-shopping-cart text-muted mb-3" style="font-size: 2rem;"></i>
                        <h3 class="text-muted">Votre panier est vide</h3>
                        <p class="text-muted">Commencez votre shopping dès maintenant !</p>
                        <a href="{{ path('app_home') }}" class="btn btn-primary mt-3">
                            <i class="fas fa-store me-2"></i>Voir nos produits
                        </a>
                    </div>
                </div>
            {% else %}
                <div class="row">
                    {# Colonne principale - Liste des produits #}
                    <div class="col-lg-8">
                        <div class="card shadow-sm mb-5">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Produit</th>
                                                <th>Prix</th>
                                                <th class="text-center">Quantité</th>
                                                <th>Total</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% set cart_total = 0 %}
                                            {% for item in cart %}
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <img src="{{ item.product.illustration ? asset('uploads/products/' ~ item.product.illustration) : asset('images/default-product.png') }}" 
                                                                 alt="{{ item.product.name }}" 
                                                                 class="img-fluid rounded me-3" 
                                                                 style="width: 80px; height: 80px; object-fit: cover;">
                                                            <div>
                                                                <strong>{{ item.product.name }}</strong>
                                                                <div class="text-muted small">
                                                                    {{ item.product.category.name }}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        {% if app.session.get('currency') == 'EUR' %}
                                                            {{ (item.product.pricewithtax / 10)|format_currency('EUR') }}
                                                        {% else %}
                                                            {{ item.product.pricewithtax|format_currency('MAD') }}
                                                        {% endif %}
                                                    </td>
                                                    <td class="text-center">
                                                        <div class="btn-group" role="group">
                                                            <a href="{{ path('app_cart_decrease', { id: item.product.id }) }}" 
                                                               class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-minus"></i>
                                                            </a>
                                                            <span class="px-3 py-1">{{ item.quantity }}</span>
                                                            <a href="{{ path('app_cart_add', { id: item.product.id }) }}" 
                                                               class="btn btn-sm btn-outline-primary">
                                                                <i class="fas fa-plus"></i>
                                                            </a>
                                                        </div>
                                                    </td>
                                                    <td class="fw-bold">
                                                        {% set total = item.product.pricewithtax * item.quantity %}
                                                        {% if app.session.get('currency') == 'EUR' %}
                                                            {{ (total / 10)|format_currency('EUR') }}
                                                        {% else %}
                                                            {{ total|format_currency('MAD') }}
                                                        {% endif %}
                                                    </td>
                                                    <td>
                                                        <a href="{{ path('app_cart_remove', { id: item.product.id }) }}" 
                                                           class="btn btn-sm btn-outline-danger">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                                {% set cart_total = cart_total + total %}
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Colonne récapitulative #}
                    <div class="col-lg-4">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h3 class="h4 mb-4 pb-3 border-bottom">
                                    <i class="fas fa-file-alt me-2 text-primary"></i>
                                    Total Panier
                                </h3>

                                <ul class="list-group list-group-flush mb-3">
                                    {% for item in cart %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                            <span class="text-truncate" style="max-width: 70%;">{{ item.product.name }}</span>
                                            <span class="badge bg-primary rounded-pill">x{{ item.quantity }}</span>
                                        </li>
                                    {% endfor %}
                                </ul>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total HT :</span>
                                    <span>
                                        {% if app.session.get('currency') == 'EUR' %}
                                            {{ ((cart_total / 1.2) / 10)|format_currency('EUR') }}
                                        {% else %}
                                            {{ (cart_total / 1.2)|format_currency('MAD') }}
                                        {% endif %}
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between mb-3 text-success">
                                    <span>TVA (20%) :</span>
                                    <span>
                                        {% if app.session.get('currency') == 'EUR' %}
                                            {{ ((cart_total - (cart_total / 1.2)) / 10)|format_currency('EUR') }}
                                        {% else %}
                                            {{ (cart_total - (cart_total / 1.2))|format_currency('MAD') }}
                                        {% endif %}
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-3 py-2 border-top border-bottom">
                                    <span class="fw-bold">Total TTC :</span>
                                    <span class="fw-bold text-primary">
                                        {% if app.session.get('currency') == 'EUR' %}
                                            {{ (cart_total / 10)|format_currency('EUR') }}
                                        {% else %}
                                            {{ cart_total|format_currency('MAD') }}
                                        {% endif %}
                                    </span>
                                </div>

                                <div class="d-grid gap-2">
                                    <a href="{{ path('app_order') }}" class="btn btn-primary">
                                        <i class="fas fa-credit-card me-2"></i>
                                        Commander
                                    </a>
                                    <a href="{{ path('app_cart_clear') }}" class="btn btn-outline-danger">
                                        <i class="fas fa-trash me-2"></i>
                                        Vider le panier
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Section Wishlist Carousel #}
                <div class="card shadow-sm mt-5">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                            <h3 class="h4 mb-0">
                                <i class="fas fa-heart text-danger me-2"></i>
                                Mes Produits Favoris
                            </h3>
                            {% if wishlistItems is not empty %}
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-outline-secondary btn-sm me-2" type="button" data-bs-target="#wishlistCarousel" data-bs-slide="prev">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-target="#wishlistCarousel" data-bs-slide="next">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                            {% endif %}
                        </div>

                        {% if wishlistItems is empty %}
                            <div class="text-center py-5">
                                <i class="fas fa-heart text-muted mb-3" style="font-size: 2rem;"></i>
                                <h4 class="text-muted">Votre wishlist est vide</h4>
                                <p class="text-muted">Ajoutez des produits à votre wishlist en cliquant sur l'icône cœur</p>
                                <a href="{{ path('app_home') }}" class="btn btn-primary mt-3">
                                    <i class="fas fa-store me-2"></i>Voir nos produits
                                </a>
                            </div>
                        {% else %}
                            <div id="wishlistCarousel" class="carousel slide mb-0" data-bs-ride="carousel">
                                <div class="carousel-inner pb-0">
                                    {% set itemsPerSlide = 4 %}
                                    {% set totalSlides = (wishlistItems|length / itemsPerSlide)|round(0, 'ceil') %}
                                    
                                    {% for slideIndex in 0..(totalSlides - 1) %}
                                        <div class="carousel-item {% if slideIndex == 0 %}active{% endif %} pb-0">
                                            <div class="row g-3 mb-0">
                                                {% set startIndex = slideIndex * itemsPerSlide %}
                                                {% set endIndex = startIndex + itemsPerSlide - 1 %}
                                                
                                                {% for i in startIndex..endIndex %}
                                                    {% if wishlistItems[i] is defined %}
                                                        {% set product = wishlistItems[i] %}
                                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                                            <div class="card h-100 border-1 wishlist-card mb-0">
                                                                <div class="position-relative overflow-hidden">
                                                                    <img src="{{ product.illustration ? asset('uploads/products/' ~ product.illustration) : asset('images/default-product.png') }}" 
                                                                         alt="{{ product.name }}"
                                                                         class="card-img-top"
                                                                         style="height: auto; object-fit: cover; transition: transform 0.3s ease;">
                                                                    
                                                                    <div class="position-absolute top-0 end-0 p-2">
                                                                        <a href="{{ path('app_account_wishlist_remove', {id: product.id}) }}" 
                                                                           class="btn btn-sm btn-danger rounded-circle shadow-sm"
                                                                           title="Retirer des favoris">
                                                                            <i class="fas fa-times"></i>
                                                                        </a>
                                                                    </div>
                                                                </div>

                                                                <div class="card-body d-flex flex-column">
                                                                    <h6 class="card-title text-truncate mb-2" title="{{ product.name }}">{{ product.name }}</h6>
                                                                    
                                                                    <div class="text-muted small mb-2">
                                                                        {% if product.category is defined %}
                                                                            {{ product.category.name }}
                                                                        {% endif %}
                                                                    </div>
                                                                    
                                                                    <div class="mt-auto">
                                                                        <div class="mb-3">
                                                                            <span class="fw-bold text-primary fs-6">
                                                                                {% if app.session.get('currency') == 'EUR' %}
                                                                                    {{ (product.pricewithtax / 10)|format_currency('EUR') }}
                                                                                {% else %}
                                                                                    {{ product.pricewithtax|format_currency('MAD') }}
                                                                                {% endif %}
                                                                            </span>
                                                                        </div>
                                                                        
                                                                        <div class="d-grid gap-2">
                                                                            <a href="{{ path('app_product', {slug: product.slug}) }}" 
                                                                               class="btn btn-sm btn-outline-primary">
                                                                                <i class="fas fa-eye me-1"></i>Voir détails
                                                                            </a>
                                                                            <a href="{{ path('app_cart_add', {id: product.id}) }}" 
                                                                               class="btn btn-sm btn-success">
                                                                                <i class="fas fa-shopping-cart me-1"></i>Ajouter au panier
                                                                            </a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>

                                {# Indicateurs de slide (optionnel) #}
                                {% if totalSlides > 1 %}
                                    <div class="carousel-indicators position-static mt-3 mb-0">
                                        {% for slideIndex in 0..(totalSlides - 1) %}
                                            <button type="button" data-bs-target="#wishlistCarousel" data-bs-slide-to="{{ slideIndex }}" 
                                                    class="{% if slideIndex == 0 %}active{% endif %}" 
                                                    style="width: 12px; height: 12px; border-radius: 50%;"
                                                    aria-label="Slide {{ slideIndex + 1 }}">
                                            </button>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .text-muted {
        font-size: 0.8em;
        opacity: 0.8;
    }
    
    .wishlist-card:hover img {
        transform: scale(1.05);
    }
    
    .wishlist-card {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef !important;
    }
    
    .wishlist-card:hover {
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        border-color: #007bff !important;
    }
    
    .carousel-indicators button {
        background-color: #6c757d;
        opacity: 0.5;
        border: none;
    }
    
    .carousel-indicators button.active {
        background-color: #007bff;
        opacity: 1;
    }
    
    /* Suppression des marges en bas du carousel */
    #wishlistCarousel .carousel-inner,
    #wishlistCarousel .carousel-item,
    #wishlistCarousel .row {
        margin-bottom: 0 !important;
    }
    
    #wishlistCarousel .card {
        margin-bottom: 0 !important;
    }
    
    @media (max-width: 767.98px) {
        .carousel-item .row .col-12:nth-child(n+3) {
            display: none;
        }
    }
    
    @media (max-width: 575.98px) {
        .carousel-item .row .col-12:nth-child(n+2) {
            display: none;
        }
    }
</style>
{% endblock %}