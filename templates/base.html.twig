								<a href="{{ path('app_account_wishlist') }}" class="btn position-relative me-3 text-secondary" aria-label="Mes favoris{% if app.user and app.user.wishlists|length > 0 %} - {{ app.user.wishlists|length }} produit{% if app.user.wishlists|length > 1 %}s{% endif %}{% endif %}">
