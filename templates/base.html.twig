							<li class="nav-item" role="none">
								<a class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}" role="menuitem" {% if app.request.attributes.get('_route') == 'app_home' %} aria-current="page" {% endif %}>Accueil</a>
							</li>
							<li class="nav-item dropdown" role="none">
