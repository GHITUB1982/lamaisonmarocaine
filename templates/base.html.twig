		<style>:root
		{
			--primary: #6B8E23; /* Vert olive naturel */
			--secondary: #C9A66B; /* Doré terreux */
			--light: #F8F5F0; /* Crème doux */
			--dark: #3E3D29; /* Brun profond */
			--accent: #A78A7F; /* Terre cuite */
		}

		body {
			font-family: 'Montserrat', sans-serif;
			background-color: var(--light);
			color: var(--dark);
		}

		h1,
		h2,
		h3,
		h4,
		h5 {
			font-family: 'Playfair Display', serif;
			color: var(--dark);
		}

		/* Navbar Style */
		.cosmetic-navbar {
			background: rgba(255, 255, 255, 0.95) !important;
			backdrop-filter: blur(8px);
			box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
			border-bottom: 1px solid rgba(0, 0, 0, 0.05);
			transition: all 0.4s ease;
		}

		.cosmetic-navbar.scrolled {
			box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
		}

		.navbar-brand {
			font-weight: 600;
			color: var(--primary) !important;
			font-size: 1.6rem;
		}

		.nav-link {
			color: var(--dark) !important;
			font-weight: 500;
			margin: 0 8px;
			position: relative;
			padding-bottom: 5px;
		}

		.nav-link:after {
			content: '';
			position: absolute;
			width: 0;
			height: 2px;
			bottom: 0;
			left: 0;
			background-color: var(--primary);
			transition: width 0.3s;
		}

		.nav-link:hover:after,
		.nav-link.active:after {
			width: 100%;
		}

		.btn-beauty {
			background-color: var(--primary);
			color: white;
			border-radius: 30px;
			padding: 8px 20px;
			font-weight: 600;
			transition: all 0.3s;
			border: none;
		}

		.btn-beauty:hover {
			background-color: var(--dark);
			transform: translateY(-2px);
			box-shadow: 0 5px 15px rgba(107, 142, 35, 0.3);
		}

		/* Cart Icon */
		.cart-icon {
			position: relative;
			color: var(--dark) !important;
		}

		.cart-badge {
			background-color: var(--primary);
		}

		/* Hero Pattern */
		.bg-herbal {
			background-size: 120px;
		}

		/* Footer */
		.cosmetic-footer {
			background: linear-gradient(135deg, var(--dark) 0%, #2a2a1e 100%);
			color: var(--light);
			padding: 60px 0 30px;
			position: relative;
			border-top: 3px solid var(--primary);
		}

		.footer-links a {
			color: #d1d1d1;
			text-decoration: none;
			transition: all 0.3s;
			display: inline-block;
			margin-bottom: 8px;
		}

		.footer-links a:hover {
			color: var(--secondary);
			transform: translateX(5px);
		}

		.social-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 40px;
			height: 40px;
			background: rgba(255, 255, 255, 0.1);
			border-radius: 50%;
			margin-right: 10px;
			color: var(--light);
			transition: all 0.3s;
		}

		.social-icon:hover {
			background: var(--primary);
			transform: translateY(-3px);
		}

		.back-to-top {
			position: fixed;
			bottom: 30px;
			right: 30px;
			background: var(--primary);
			color: white;
			width: 50px;
			height: 50px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
			transition: all 0.3s;
			z-index: 99;
		}

		.back-to-top:hover {
			background: var(--dark);
			transform: translateY(-5px);
		}

		/* Special Elements */
		.ingredient-badge {
			background-color: var(--light);
			color: var(--primary);
			border: 1px solid var(--primary);
			border-radius: 20px;
			padding: 3px 12px;
			font-size: 0.8rem;
			margin-right: 5px;
			margin-bottom: 5px;
			display: inline-block;
		}
	</style>
</head>

