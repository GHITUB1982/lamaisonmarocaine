            </div>
        </div>
    </ul>
</li>							<li class="nav-item" role="none">
								<a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_blog' ? 'active' : '' }}" href="{{ path('app_blog_posts')}}" role="menuitem" {% if app.request.attributes.get('_route') starts with 'app_blog' %} aria-current="page" {% endif %}>Blog</a>
