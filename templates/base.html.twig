                            <li role="none">
                                <a class="dropdown-item d-flex align-items-center py-2" href="{{ path('show_category', {'slug': category.slug}) }}" role="menuitem">
                                    {% if category.products|slice(0, 4) and category.menu == 1 %}
                                        <img src="/uploads/products/{{ category.products[0].illustration }}" loading="lazy" alt="" class="me-3 flex-shrink-0" style="width: 140px; height: 140px; object-fit: cover; border-radius: 4px;" aria-hidden="true">
