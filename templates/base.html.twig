							<a href="{{ path('app_cart')}}" class="btn position-relative me-3 text-secondary" aria-label="Panier{% if fullQuantity > 0 %} - {{ fullQuantity }} produit{% if fullQuantity > 1 %}s{% endif %}{% endif %}">
								<i class="fas fa-shopping-cart" aria-hidden="true"></i>
