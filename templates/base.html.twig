<script>
	// Navbar scroll effect
window.addEventListener('scroll', function () {
const navbar = document.querySelector('.cosmetic-navbar');
if (window.scrollY > 30) {
navbar.classList.add('scrolled');
} else {
navbar.classList.remove('scrolled');
}
});

// Back to top button
document.querySelector('.back-to-top').addEventListener('click', function (e) {
e.preventDefault();
window.scrollTo({top: 0, behavior: 'smooth'});
});

// Gestion des animations
document.addEventListener('DOMContentLoaded', () => {
const alerts = document.querySelectorAll('.alert');

alerts.forEach(alert => {
setTimeout(() => {
alert.style.transform = 'translateY(70px)';
alert.style.transition = 'transform 0.3s ease-out';
}, 50);

setTimeout(() => {
alert.style.opacity = '0';
setTimeout(() => alert.remove(), 300);
}, 5000);

alert.querySelector('.btn-close').addEventListener('click', () => {
alert.style.opacity = '0';
setTimeout(() => alert.remove(), 300);
});
});
});

function openWhatsApp() {
const number = '212674819089';
const defaultMessage = 'Bonjour, je vous contacte depuis le site';
const encodedMessage = encodeURIComponent(defaultMessage);

// Essayer d'ouvrir l'app mobile
window.location.href = `whatsapp://send?phone=${number}&text=${encodedMessage}`;

// Fallback pour desktop ou si l'app n'est pas installée
setTimeout(() => {
window.open(`https://wa.me/${number}?text=${encodedMessage}`, '_blank');
}, 200);
}

// Activation du menu déroulant au survol (desktop seulement)
const dropdownElements = document.querySelectorAll('.dropdown');

function setupHoverForDropdowns() {
if (window.innerWidth > 992) { // Desktop
dropdownElements.forEach(function (dropdown) {
const toggle = dropdown.querySelector('.dropdown-toggle');

dropdown.addEventListener('mouseenter', function () {
const bsDropdown = bootstrap.Dropdown.getOrCreateInstance(toggle);
bsDropdown.show();
});

dropdown.addEventListener('mouseleave', function () {
const bsDropdown = bootstrap.Dropdown.getInstance(toggle);
bsDropdown.hide();
});
});
} else { // Mobile
dropdownElements.forEach(function (dropdown) {
const toggle = dropdown.querySelector('.dropdown-toggle');
bootstrap.Dropdown.getOrCreateInstance(toggle).dispose();
});
}
}

// Initial setup
setupHoverForDropdowns();

// Re-setup on window resize
window.addEventListener('resize', setupHoverForDropdowns);
</script></body></html>
