					<!-- JavaScript - Load at the end for better performance -->
					<script src="{{asset('/assets/js/bootstrap.bundle.min.js')}}"></script>

					<!-- Cookie Consent Script - Load asynchronously -->
					<script>
						function loadCookieConsent() {
const script = document.createElement('script');
script.src = 'https://cdn.jsdelivr.net/npm/cookieconsent@3/build/cookieconsent.min.js';
script.onload = function () {
window.cookieconsent.initialise({
palette: {
popup: {
background: "#000"
},
button: {
background: "#f1d600"
}
},
theme: "classic",
content: {
message: "Ce site utilise des cookies pour vous garantir la meilleure expérience.",
dismiss: "J'accepte",
link: "En savoir plus",
href: "{{ path('app_reglementation_show', {'route': 'confidentialite'}) }}"
}
});
};
document.head.appendChild(script);
}

// Load cookie consent after page load
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', loadCookieConsent);
} else {
