		<script>
			// Navbar scroll effect
window.addEventListener('scroll', function () {
const navbar = document.querySelector('.cosmetic-navbar');
if (window.scrollY > 30) {
navbar.classList.add('scrolled');
} else {
navbar.classList.remove('scrolled');
}
});

// Back to top button
document.querySelector('.back-to-top').addEventListener('click', function (e) {
e.preventDefault();
window.scrollTo({top: 0, behavior: 'smooth'});
});

// Gestion des animations
document.addEventListener('DOMContentLoaded', () => {
const alerts = document.querySelectorAll('.alert');

alerts.forEach(alert => { // Animation d'entrée
setTimeout(() => {
alert.style.transform = 'translateY(70px)';
alert.style.transition = 'transform 0.3s ease-out';
}, 50);

// Fermeture automatique après 5s
setTimeout(() => {
alert.style.opacity = '0';
setTimeout(() => alert.remove(), 300);
}, 5000);

// Fermeture au clic
alert.querySelector('.btn-close').addEventListener('click', () => {
alert.style.opacity = '0';
setTimeout(() => alert.remove(), 300);
});
});
});
		</script>
