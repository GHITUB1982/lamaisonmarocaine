{% extends 'base.html.twig' %}

{% block title %}Blog - {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.css">
 
{% endblock %}

{% block body %}
<div class="container py-5">
    {# Breadcrumb #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item active">Blog</li>
        </ol>
    </nav>

    {# En-tête #}
            {# Titre de la page #}
            <h1 class="display-5 mb-4">Nos Articles</h1>
<hr>
    {# Contenu principal #}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        {% for post in posts %}
            <div class="col">
                <div class="blog-card card h-100">
                    {# Image de l'article #}
                    <div class="card-img-container">
                        {% if post.featuredImage %}
                            <img src="{{ asset('uploads/products/blog/img/' ~ post.featuredImage) }}" 
                                 class="card-img-top" 
                                 alt="{{ post.title }}">
                        {% else %}
                            <i data-feather="file-text" class="text-muted" style="width: 48px; height: 48px;"></i>
                        {% endif %}
                    </div>
                    
                    {# Corps de la carte #}
                    <div class="card-body">
                        <h5 class="card-title">{{ post.title }}</h5>
                        {% if post.category %}
                            <span class="badge bg-info mb-2">{{ post.category.name }}</span>
                        {% endif %}
                        <p class="card-text" style="text-align: justify;">
                            {{ post.excerpt|default(post.content|striptags|slice(0, 150)) }}...
                        </p>
                    </div>
                    
                    {# Pied de carte #}
                    <div class="card-footer bg-transparent">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                <i data-feather="calendar" style="width: 14px; height: 14px;"></i>
                                {{ post.createdAt|date('d/m/Y') }}
                            </small>
                            <a href="{{ path('app_blog_show', {slug: post.slug}) }}" 
                               class="btn btn-sm btn-outline-primary">
                                Lire
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    Aucun article disponible pour le moment.
                </div>
            </div>
        {% endfor %}
    </div>

    {# Pagination #}
    {% if posts|length > 0 %}
    <div class="pagination-container m-3">
        <nav aria-label="Pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item {% if current_page == 1 %}disabled{% endif %}">
                    <a class="page-link" href="{{ path('app_blog_posts', {page: current_page - 1}) }}" aria-label="Précédent">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                </li>
                
                {% for i in 1..total_pages %}
                    <li class="page-item {% if current_page == i %}active{% endif %}">
                        <a class="page-link" href="{{ path('app_blog_posts', {page: i}) }}">{{ i }}</a>
                    </li>
                {% endfor %}
                
                <li class="page-item {% if current_page == total_pages %}disabled{% endif %}">
                    <a class="page-link" href="{{ path('app_blog_posts', {page: current_page + 1}) }}" aria-label="Suivant">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            feather.replace();
        });
    </script>
{% endblock %}