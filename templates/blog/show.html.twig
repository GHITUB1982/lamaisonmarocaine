{% extends 'base.html.twig' %}

{% block title %}
    {{ blog.title }} - {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.css">

{% endblock %}

{% block body %}
    <div class="container py-5">
        {# Breadcrumb #}
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_blog_posts') }}">Blog</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ blog.title|u.truncate(30, '...') }}</li>
            </ol>
        </nav>

        {# En-tête #}
        <div class="d-flex justify-content-between align-items-center mb-4 py-3 border-bottom blog-header">
            <h1 class="mb-0 fs-3 fw-bold text-primary">{{ blog.title }}</h1>
            <div class="text-muted small">
                <i data-feather="calendar" class="me-1"></i>
                {{ blog.createdAt|date('d/m/Y') }}
            </div>
        </div>

        {# Contenu principal #}
        <div class="blog-content-container">
            <div class="card border-0 shadow-sm">
                <div class="row g-0">
                    {% if blog.featuredImage %}
                    <div class="col-md-5 p-3 bg-transparent">
                        <img src="{{ asset('uploads/products/blog/img/' ~ blog.featuredImage) }}"
                             alt="{{ blog.title }}"
                             class="img-fluid rounded-3 w-100"
                             style="max-height: 400px; object-fit: contain;">
                    </div>
                    {% endif %}

                    <div class="col-md-7">
                        <div class="card-body h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h2 class="card-title mb-1">{{ blog.title }}</h2>
                                    {% if blog.category %}
                                    <span class="badge bg-info text-dark">{{ blog.category.name }}</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="blog-content card-text flex-grow-1 py-3 border-top border-bottom">
                                {{ blog.content|raw }}
                            </div>

                            <div class="mt-4">
                                <a href="{{ path('app_blog_posts') }}" class="btn btn-outline-primary">
                                    <i data-feather="arrow-left"></i> Retour aux articles
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            feather.replace();
        });
    </script>
{% endblock %}